# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. NEVER commit real keys.
#
# None of these use the NEXT_PUBLIC_ prefix, and they must not. That prefix
# inlines a value into the browser bundle, which is exactly how the previous
# version of this app leaked its keys.

# Required. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-3.5-flash.
# Deliberately a pinned version, not the gemini-flash-latest alias: that alias
# resolves to Google's default model, which is the most contended one and was
# measured returning 503 after 65s while pinned versions answered in ~1.4s.
# Alternatives if this one is slow: gemini-3.6-flash, gemini-3.1-flash-lite.
GEMINI_MODEL=gemini-3.5-flash

# Strongly recommended. A fine-grained personal access token with public
# repository read access is enough.
# Without it GitHub allows only 60 requests/hour per IP; with it, 5,000/hour.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# Optional, only for the 21st.dev Magic MCP server used during UI development.
# Not used by the app at runtime. Get a key at https://21st.dev/mcp
TWENTY_FIRST_API_KEY=

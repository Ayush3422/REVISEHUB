# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored. NEVER commit real keys.
#
# None of these use the NEXT_PUBLIC_ prefix, and they must not. That prefix
# inlines a value into the browser bundle, which is exactly how the previous
# version of this app leaked its keys.

# Required. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=gemini-2.5-flash

# Strongly recommended. A fine-grained personal access token with public
# repository read access is enough.
# Without it GitHub allows only 60 requests/hour per IP; with it, 5,000/hour.
# https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.3.0",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.0.0",
    "vitest": "^3.2.7"
